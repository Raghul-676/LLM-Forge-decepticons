# ============================================================
# Decepticons Legal AI - Environment Configuration Example
# ============================================================
# Copy this file to .env and replace the placeholder values with your actual credentials.
# Command: cp .env.example .env (or copy .env.example .env in Windows CMD)

# Hugging Face User Access Token (used for downloading models, tokenizers, or private weights)
HF_TOKEN=your_huggingface_token_here

# Groq API Key (used for fast LLM inference across GPT-OSS, Qwen, and Llama models)
GROQ_API_KEY=your_groq_api_key_here
